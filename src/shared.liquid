{%- assign plugin_title = trmnl.plugin_settings.instance_name | default: "Is This Weather Normal?" -%}
{%- capture inst_text -%}{{ loc }}{%- endcapture -%}
{%- capture skip_inst -%}Screen skipped &middot; {{ updated_at }}{%- endcapture -%}
{%- capture icon_svg -%}
