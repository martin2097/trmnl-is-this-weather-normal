{% if skip_generation %}
  <div class="layout layout--col">
    {% render "skipped_state", err: error %}
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: skip_inst %}
  {% elsif initial_failure %}
  <div class="layout layout--col">
    {% render "initial_failure_state" %}
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: updated_at %}
  {% elsif ok == false %}
  <div class="layout layout--col">
    {% render "error_state", err: error %}
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: updated_at %}
  {% else %}
  <div class="layout layout--col gap--distribute lg:gap--small lg:portrait:gap--distribute stretch-y mx--1">
    <div class="flex flex--col flex--left gap--none no-shrink w--full">
      <span class="title title--small lg:title--base font--bold">
        {{ headline | upcase }}
      </span>
      <span class="description description--small">
        {{ subline }}
      </span>
    </div>
    <div class="divider stretch-x no-shrink"></div>
    <div class="lg:hidden lg:portrait:visible w--full">
      <div class="grid">
        <div class="col col--span-8 lg:portrait:col--span-12">
          <span class="label label--small font--bold">TODAY</span>
          <span class="value value--small lg:portrait:value--large font--bold text--left">
            {{ hi }}
             °
          </span>
          <span class="label label--small">
            {{ today_flag | upcase }}
          </span>
          <div class="divider my--1 w--10"></div>
          <span class="text text--base">
            Low
            <span class="value value--xxsmall lg:value--xsmall font--bold">
              {{ lo }}
               °
            </span>
          </span>
          {% if today_night_line != "" %}
            <span class="description">
              {{ today_night_line }}
            </span>
          {% endif %}
          <span class="description">
            {{ today_rain_line }}
          </span>
        </div>
        <div class="divider--v"></div>
        <div class="col col--span-12 lg:portrait:col--span-12">
          <span class="label label--small font--bold">YESTERDAY</span>
          {% if yday_hi %}
            <span class="value value--xxsmall lg:value--xsmall font--bold">
              {{ yday_hi }}
               °
            </span>
          {% endif %}
          <span class="description description--small">
            {{ yday_note }}
          </span>
          <div class="divider my--2"></div>
          <span class="label label--small font--bold">LAST 30 DAYS</span>
          {% if t30_delta %}
            <span class="value value--xxsmall lg:value--xsmall font--bold">
              {{ t30_delta }}
                 °
              <span class="description description--small font--regular">vs normal</span>
            </span>
            {% else %}
            <span class="description description--small">
              {{ t30_line }}
            </span>
          {% endif %}
          <span class="description description--small">
            {{ rain_line }}
          </span>
        </div>
      </div>
    </div>
    <div class="hidden lg:portrait:visible divider stretch-x no-shrink"></div>
    <div class="hidden lg:portrait:flex flex--col flex--left">
      <span class="description description--small">
        {{ date_label | upcase }}
             HIGHS DISTRIBUTION · Since
        {{ since_year }}
      </span>
      <div class="flex">
        <div class="js-instrument" data-variant="full" data-chrome="180" data-chrome-p="320"></div>
      </div>
    </div>
    <div class="hidden lg:grid lg:portrait:hidden">
      <div class="col col--span-7 gap--distribute">
        <div class="flex flex--col flex--left gap--none">
          <span class="label label--small font--bold">TODAY</span>
          <span class="value value--base font--bold text--left">
            {{ hi }}
             °
          </span>
          <span class="label label--small">
            {{ today_flag | upcase }}
          </span>
          <div class="divider my--1 w--10"></div>
          <span class="text text--base">
            Low
            <span class="value value--xsmall font--bold">
              {{ lo }}
               °
            </span>
          </span>
          {% if today_night_line != "" %}
            <span class="description">
              {{ today_night_line }}
            </span>
          {% endif %}
          <span class="description">
            {{ today_rain_line }}
          </span>
        </div>
        <div class="divider"></div>
        <div class="flex flex--col flex--left gap--none">
          <span class="label label--small font--bold">YESTERDAY</span>
          {% if yday_hi %}
            <span class="value value--xsmall font--bold">
              {{ yday_hi }}
               °
            </span>
          {% endif %}
          <span class="description description--small">
            {{ yday_note }}
          </span>
        </div>
        <div class="divider"></div>
        <div class="flex flex--col flex--left gap--none">
          <span class="label label--small font--bold">LAST 30 DAYS</span>
          {% if t30_delta %}
            <span class="value value--xsmall font--bold">
              {{ t30_delta }}
                 °
              <span class="description description--small font--regular">vs normal</span>
            </span>
            {% else %}
            <span class="description description--small">
              {{ t30_line }}
            </span>
          {% endif %}
          <span class="description description--small">
            {{ rain_line }}
          </span>
        </div>
      </div>
      <div class="col col--span-5">
        <div class="lg:portrait:hidden flex flex--col flex--left">
          <span class="description description--small">
            {{ date_label | upcase }}
             HIGHS DISTRIBUTION
          </span>
          <div class="flex">
            <div class="js-instrument" data-variant="full" data-chrome="90" data-chrome-p="120"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: inst_text %}
{% endif %}
