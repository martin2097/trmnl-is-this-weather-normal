{% if skip_generation %}
  <div class="layout layout--col">
    {% render "skipped_state", err: error %}
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: skip_inst %}
  {% elsif initial_failure %}
  <div class="layout layout--col">
    {% render "initial_failure_state" %}
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: updated_at %}
  {% elsif ok == false %}
  <div class="layout layout--col">
    {% render "error_state", err: error %}
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: updated_at %}
  {% else %}
  <div class="layout layout--col gap--small lg:gap--large stretch-y my--4 mx--6">
    <div class="flex flex--col flex--left gap--none no-shrink w--full">
      <span class="title title--large lg:text--xxlarge font--bold">
        {{ headline | upcase }}
      </span>
      <span class="description description--small lg:description--base">
        {{ subline }}
      </span>
    </div>
    <div class="divider stretch-x no-shrink"></div>
    <div class="grid grid--cols-12 portrait:grid--cols-1 stretch-y">
      <div class="col--span-7 portrait:col--span-1 flex flex--col gap--distribute lg:portrait:gap--large stretch-y text--left mb--2">
        <div class="flex flex--col flex--left stretch-x gap--none no-shrink text--left">
          <span class="label label--small lg:label--base font--bold">TODAY</span>
          <span class="value value--large lg:value--xxxlarge font--bold text--left">
            {{ hi }}
             °
          </span>
          <span class="label label--small lg:label--base">
            {{ today_flag | upcase }}
          </span>
          <div class="divider my--1 lg:my--4 w--10"></div>
          <span class="text text--base lg:text--large">
            Low
            <span class="value value--xsmall lg:value--small font--bold">
              {{ lo }}
               °
            </span>
          </span>
          {% if today_night_line != "" %}
            <span class="description">
              {{ today_night_line }}
            </span>
          {% endif %}
          <span class="description">
            {{ today_rain_line }}
          </span>
        </div>
        <div class="divider stretch-x no-shrink"></div>
        <div class="flex flex--row flex--left stretch-x gap--large lg:gap--xxlarge">
          <div class="flex flex--col flex--left gap--small">
            <span class="label label--small lg:label--base font--bold">YESTERDAY</span>
            {% if yday_hi %}
              <span class="value value--xsmall lg:value--small font--bold">
                {{ yday_hi }}
               °
              </span>
            {% endif %}
            <span class="description description--small">
              {{ yday_note }}
            </span>
          </div>
          <div class="divider--v"></div>
          <div class="flex flex--col flex--left gap--small">
            <span class="label label--small lg:label--base font--bold">LAST 30 DAYS</span>
            <div class="flex flex--row flex--left flex--bottom gap--xsmall">
              {% if t30_delta %}
                <span class="value value--xsmall lg:value--small font--bold">
                  {{ t30_delta }}
                 °
                </span>
                <span class="description description--small">vs normal</span>
                {% else %}
                <span class="description description--small">
                  {{ t30_line }}
                </span>
              {% endif %}
            </div>
            <span class="description description--small">
              {{ rain_line }}
            </span>
          </div>
        </div>
        <div class="divider stretch-x no-shrink"></div>
        <div class="flex flex--col flex--left stretch-x gap--small no-shrink text--left">
          <span class="label label--small lg:label--base font--bold">
            {{ date_label | upcase }}
             HIGHS IN HISTORY
          </span>
          <div class="flex flex--row flex--left stretch-x gap--large lg:gap--xlarge lg:portrait:gap--xxlarge">
            <div class="flex flex--col flex--left gap--none">
              <span class="label label--small lg:label--base">Normal</span>
              <span class="value value--xxsmall lg:value--xsmall">
                {{ normal_lo }}
                –
                {{ normal_hi }}
                 °
              </span>
            </div>
            <div class="divider--v"></div>
            <div class="flex flex--col flex--left gap--none">
              <span class="label label--small lg:label--base">Warmest</span>
              <span class="value value--xxsmall lg:value--xsmall">
                {{ record_hi }}
                 ° (
                {{ record_hi_year }}
                )
              </span>
            </div>
            <div class="divider--v"></div>
            <div class="flex flex--col flex--left gap--none">
              <span class="label label--small lg:label--base">Coolest</span>
              <span class="value value--xxsmall lg:value--xsmall">
                {{ record_lo }}
                 ° (
                {{ record_lo_year }}
                )
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="hidden divider lg:portrait:visible stretch-x no-shrink"></div>
      <div class="col--span-5 portrait:col--span-1 flex flex--col stretch-y text--left">
        <!-- chart container: change flex--left → flex--center / flex--right to move the label+chart block; add p--*/pl--* to pad -->
        <div class="flex flex--col flex--left stretch-x gap--none lg:gap--xsmall pl--6 lg:pl--16 lg:portrait:px--36">
          <span class="label label--small">
            {{ date_label | upcase }}
             HIGHS DISTRIBUTION · Since
            {{ since_year }}
          </span>
          <div class="lg:mt--4 w--full h--auto">
            <div class="js-instrument" data-variant="full" data-chrome="120" data-chrome-p="460"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: inst_text %}
{% endif %}
