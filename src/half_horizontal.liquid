{% if ok == false %}
  <div class="layout layout--col">
    {% render "skipped_state", err: error %}
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: skip_inst %}
  {% else %}
  <div class="layout layout--col lg:gap--medium stretch-y my--1 mx--2">
    <div class="flex lg:hidden lg:portrait:flex flex--col flex--left gap--none no-shrink w--full">
      <span class="title title--base lg:title--large font--bold">
        {{ headline | upcase }}
      </span>
      <span class="description description--small">
        {{ subline }}
      </span>
    </div>
    <div class="lg:hidden lg:portrait:visible divider stretch-x no-shrink"></div>
    <div class="grid grid--cols-12 stretch-y">
      <div class="col--span-7 flex flex--col gap--distribute stretch-y text--left mb--2">
        <div class="hidden lg:flex lg:portrait:hidden flex--col flex--left gap--none no-shrink w--full">
          <span class="title lg:title--large font--bold">
            {{ headline | upcase }}
          </span>
          <span class="description description--small">
            {{ subline }}
          </span>
        </div>
        <div class="hidden lg:visible lg:portrait:hidden divider stretch-x no-shrink"></div>
        <div class="grid lg:portrait:hidden">
          <div class="col col--span-4 stretch-y gap--none no-shrink text--left">
            <span class="label label--small font--bold">TODAY</span>
            <span class="value value--base lg:value--large font--bold text--left">
              {{ hi }}
             °
            </span>
            <span class="label label--small">
              {{ today_flag | upcase }}
            </span>
            <div class="divider my--1 w--10"></div>
            <span class="text text--base">
            Low 
              <span class="value value--xxsmall lg:value--xsmall font--bold">
                {{ lo }}
               °
              </span>
            </span>
            {% if today_night_line != "" %}
              <span class="description">
                {{ today_night_line }}
              </span>
            {% endif %}
            <span class="description">
              {{ today_rain_line }}
            </span>
          </div>
          <div class="hidden lg:portrait:visible divider no-shrink"></div>
          <div class="col--span-1 divider--v no-shrink"></div>
          <div class="col col--span-5 lg:portrait:hidden gap--small lg:gap--base lg:portrait:gap--large">
            <div class="flex flex--col flex--left gap--none lg:gap--small">
              <span class="label label--small font--bold">YESTERDAY</span>
              {% if yday_hi %}
                <span class="value value--xxsmall lg:value-xsmall font--bold">
                  {{ yday_hi }}
                                   °
                </span>
              {% endif %}
              <span class="description description--small">
                {{ yday_note }}
              </span>
            </div>
            <div class="hidden lg:portrait:visible divider--v"></div>
            <div class="lg:portrait:hidden divider"></div>
            <div class="flex flex--col flex--left gap--none lg:gap--small">
              <span class="label label--small font--bold">LAST 30 DAYS</span>
              <div class="flex flex--row flex--left flex--bottom gap--xsmall">
                {% if t30_delta %}
                  <span class="value value--xxsmall lg:value--xsmall font--bold">
                    {{ t30_delta }}
                   °
                  </span>
                  <span class="description description--small">vs normal</span>
                  {% else %}
                  <span class="description description--small">
                    {{ t30_line }}
                  </span>
                {% endif %}
              </div>
              <span class="description description--small">
                {{ rain_line }}
              </span>
            </div>
          </div>
        </div>
        <div class="hidden lg:portrait:flex flex--col stretch gap--auto">
          <div class="flex flex--col flex--left stretch-y gap--none no-shrink text--left">
            <span class="label label--small font--bold">TODAY</span>
            <span class="value value--base lg:value--large font--bold text--left">
              {{ hi }}
             °
            </span>
            <span class="label label--small">
              {{ today_flag | upcase }}
            </span>
            <div class="divider my--1 w--10"></div>
            <span class="text text--base">
            Low 
              <span class="value value--xsmall font--bold">
                {{ lo }}
              </span>
            </span>
            {% if today_night_line != "" %}
              <span class="description">
                {{ today_night_line }}
              </span>
            {% endif %}
            <span class="description">
              {{ today_rain_line }}
            </span>
          </div>
          <div class="divider no-shrink"></div>
          <div class="flex flex--row flex--left lg:gap--large stretch-y">
            <div class="flex flex--col flex--left gap--none lg:gap--small">
              <span class="label label--small font--bold">YESTERDAY</span>
              {% if yday_hi %}
                <span class="value value--xsmall font--bold">
                  {{ yday_hi }}
                 °
                </span>
              {% endif %}
              <span class="description description--small">
                {{ yday_note }}
              </span>
            </div>
            <div class="hidden lg:portrait:visible divider--v"></div>
            <div class="lg:portrait:hidden divider"></div>
            <div class="flex flex--col flex--left gap--none lg:gap--small">
              <span class="label label--small font--bold">LAST 30 DAYS</span>
              <div class="flex flex--row flex--left flex--bottom gap--xsmall">
                {% if t30_delta %}
                  <span class="value value--xsmall font--bold">
                    {{ t30_delta }}
                   °
                  </span>
                  <span class="description description--small">vs normal</span>
                  {% else %}
                  <span class="description description--small">
                    {{ t30_line }}
                  </span>
                {% endif %}
              </div>
              <span class="description description--small">
                {{ rain_line }}
              </span>
            </div>
          </div>
          <div class="hidden lg:visible divider"></div>
        </div>
        <div class="hidden lg:visible lg:portrait:hidden divider"></div>
        <div class="hidden lg:flex flex--col flex--left stretch-x gap--small no-shrink text--left">
          <span class="label label--small font--bold">
            {{ date_label | upcase }}
             HIGHS IN HISTORY
          </span>
          <div class="flex flex--row flex--left stretch-x gap--large">
            <div class="flex flex--col flex--left gap--none">
              <span class="label label--small">Normal</span>
              <span class="value value--xxsmall">
                {{ normal_lo }}
                –
                {{ normal_hi }}
                 °
              </span>
            </div>
            <div class="divider--v"></div>
            <div class="flex flex--col flex--left gap--none">
              <span class="label label--small">Warmest</span>
              <span class="value value--xxsmall">
                {{ record_hi }}
                 ° (
                {{ record_hi_year }}
                )
              </span>
            </div>
            <div class="divider--v"></div>
            <div class="flex flex--col flex--left gap--none">
              <span class="label label--small">Coolest</span>
              <span class="value value--xxsmall">
                {{ record_lo }}
                 ° (
                {{ record_lo_year }}
                )
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="col--span-5 flex flex--col stretch-y text--left">
        <!--        chart container: change flex--left → flex--center / flex--right to move the label+chart block; add p--*/pl--* to pad        -->
        <div class="flex flex--col flex--left stretch-x gap--none pl--6">
          <span class="hidden lg:visible label label--small">
            {{ date_label | upcase }}
             HIGHS DISTRIBUTION · Since 
            {{ since_year }}
          </span>
          <div class="hidden lg:portrait:visible mx--4">
            <div class="js-instrument" data-variant="full" data-chrome="120" data-chrome-p="520"></div>
          </div>
          <div class="hidden lg:visible lg:portrait:hidden">
            <div class="js-instrument" data-variant="full" data-chrome="20" data-chrome-p="520"></div>
          </div>
          <div class="lg:hidden">
            <div class="js-instrument" data-variant="full" data-chrome="50" data-chrome-p="520"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% render "titlebar", icon: icon_svg, title: plugin_title, inst: inst_text %}
{% endif %}